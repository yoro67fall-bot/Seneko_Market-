SENEPAY_DEFAULT_RETURN_URL=https://senekomarket.com/?payment_return=success
SENEPAY_DEFAULT_CANCEL_URL=https://senekomarket.com/?payment_return=cancel
SENEPAY_WEBHOOK_URL=http://127.0.0.1:8080/webhooks/senepay

CRON_SECRET=change-me-cron-secret
# Rent/sponsor amounts below this skip NabooPay/SenePay and complete instantly (default 1000 XOF).
PAYMENT_PROVIDER_MIN_AMOUNT=1000
# POST { phone, message } — rent reminders, ID/product rejections, shop hidden
WHATSAPP_REMINDER_WEBHOOK_URL=
