PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_API_URL=http://127.0.0.1:8080
UPLOAD_ROOT=./uploads
CORS_ORIGINS=http://127.0.0.1:8888,http://localhost:8888,http://127.0.0.1:5000
ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:8888,http://localhost:8888,http://127.0.0.1:5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
NABOOPAY_DEFAULT_RETURN_URL=http://127.0.0.1:8888/?payment_return=success
NABOOPAY_DEFAULT_CANCEL_URL=http://127.0.0.1:8888/?payment_return=cancel
NABOOPAY_FEES_CUSTOMER_SIDE=false

SENEPAY_API_KEY=
SENEPAY_API_SECRET=
SENEPAY_WEBHOOK_SECRET=
